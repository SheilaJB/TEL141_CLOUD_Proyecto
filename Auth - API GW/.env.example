DATABASE_URL=postgresql+psycopg://cloud_admin:change-me@host.docker.internal:5432/cloud_g3
JWT_PRIVATE_KEY_PATH=/run/edge-keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=/run/edge-keys/jwt-public.pem
TLS_CERT_PATH=/run/edge-keys/edge.crt
TLS_KEY_PATH=/run/edge-keys/edge.key
CA_CERT_PATH=/run/edge-keys/ca.crt
INTERNAL_SERVICE_TOKEN=change-me
UPSTREAM_CRUDS_URL=http://host.docker.internal:8001
UPSTREAM_SLICE_MANAGER_URL=http://host.docker.internal:8000
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=7
COOKIE_SECURE=true
CORS_ORIGINS=["http://localhost:3000"]
EDGE_PORT=443
EDGE_KEYS_DIR=./keys
