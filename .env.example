# PostgreSQL (base de datos de la aplicación y de Temporal)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cloud_g3
APP_DB_USER=cloud_admin
APP_DB_PASSWORD=change-me
TEMPORAL_DB_USER=temporal
TEMPORAL_DB_PASSWORD=change-me

# Imágenes de Temporal
TEMPORAL_VERSION=1.31.0
TEMPORAL_ADMINTOOLS_VERSION=1.31.0
TEMPORAL_UI_VERSION=2.55.0

# Orquestador
ORCHESTRATOR_TEMPORAL_NAMESPACE=default
ORCHESTRATOR_TEMPORAL_TASK_QUEUE=orchestrator-queue
ORCHESTRATOR_INTERNAL_SERVICE_TOKEN=change-me-internal-token
ORCHESTRATOR_SIMULATED_PLACEMENT_SERVER_ID=1
APPROVAL_TIMEOUT_SECONDS=86400

# Edge API Gateway
EDGE_PORT=443
EDGE_KEYS_DIR=./Auth - API GW/keys
DATABASE_URL=postgresql+psycopg://cloud_admin:change-me-app-db@postgres:5432/cloud_g3
CORS_ORIGINS=["http://localhost:5173", "http://localhost:5174"]

EDGE_KEYS_DIR=./Auth - API GW/keys      #/opt/cloud-g3/keys
JWT_PRIVATE_KEY_PATH=/run/edge-keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=/run/edge-keys/jwt-public.pem
TLS_CERT_PATH=/run/edge-keys/edge.crt
TLS_KEY_PATH=/run/edge-keys/edge.key
CA_CERT_PATH=/run/edge-keys/ca.crt

ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=7
DATABASE_URL=postgresql+psycopg://cloud_admin:change-me@postgres:5432/cloud_g3
INTERNAL_SERVICE_TOKEN=4f10228bcac31e22155deea948bf9b7245e5758dc5aa9c08bb7cae8005d9e937

INTERNAL_SERVICE_TOKEN=change-me-internal-token
# Placeholder: replace with the CRUD API service name when it is added to the compose.
UPSTREAM_CRUDS_URL=http://crud-service:8001
UPSTREAM_SLICE_MANAGER_URL=http://slice-manager:8000