@baseUrl = https://localhost:3000
@consumerCodigo = 20260002
@consumerPassword = consumidor

@consumerToken = {{consumerLogin.response.body.$.access_token}}
@consumerRefreshToken = {{consumerLogin.response.body.$.refresh_token}}

@sliceId = {{createSlice.response.body.$.slice_id}}
@versionNumber = {{createSlice.response.body.$.numero_version}}
@deploymentId = {{deploy.response.body.$.deployment_id}}

### Health check
GET {{baseUrl}}/healthz

### Login
# @name consumerLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "codigo": "{{consumerCodigo}}",
  "password": "{{consumerPassword}}",
  "client": "cli"
}

### Crear Slice with spec ex1
# @name createSlice
POST {{baseUrl}}/slices
Authorization: Bearer {{consumerToken}}
Content-Type: application/json

{
  "name": "deploy-approval-test",
  "zona_id": 1,
  "spec": {
    "schema_version": 1,
    "vms": [
      {
        "name": "vm1",
        "flavor": "verde-ex1",
        "image": "Ubuntu",
        "public": true
      },
      {
        "name": "vm2",
        "flavor": "rojo-ex1",
        "image": "Cirros",
        "public": false
      },
      {
        "name": "vm3",
        "flavor": "verde-ex1",
        "image": "Ubuntu",
        "public": true
      },
      {
        "name": "vm4",
        "flavor": "verde-ex1",
        "image": "Ubuntu",
        "public": false
      },
      {
        "name": "vm5",
        "flavor": "verde-ex1",
        "image": "Ubuntu",
        "public": false
      },
      {
        "name": "vm6",
        "flavor": "rojo-ex1",
        "image": "Cirros",
        "public": false
      }
    ],
    "links": [
      {
        "name": "l-vm6-vm5",
        "endpoints": ["vm6", "vm5"]
      },
      {
        "name": "l-vm5-vm4",
        "endpoints": ["vm5", "vm4"]
      },
      {
        "name": "l-vm4-vm1",
        "endpoints": ["vm4", "vm1"]
      },
      {
        "name": "l-vm4-vm3",
        "endpoints": ["vm4", "vm3"]
      },
      {
        "name": "l-vm1-vm2",
        "endpoints": ["vm1", "vm2"]
      },
      {
        "name": "l-vm3-vm2",
        "endpoints": ["vm3", "vm2"]
      }
    ]
  }
}


### Inspect the preview plan
POST {{baseUrl}}/slices/{{sliceId}}/versions/{{versionNumber}}/plan
Authorization: Bearer {{consumerToken}}

### Start real Deploy
# @name deploy
POST {{baseUrl}}/slices/{{sliceId}}/versions/{{versionNumber}}/deploy
Authorization: Bearer {{consumerToken}}

###